# Exemplo de variaveis de ambiente para desenvolvimento local.
# Copie para .env e ajuste conforme necessario:
#   cp .env.example .env
#
# Em producao, gerar DJANGO_SECRET_KEY com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# Django
DJANGO_SECRET_KEY=changeme-generate-with-secrets-token-urlsafe
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (deve casar com docker-compose.yml)
POSTGRES_DB=anco
POSTGRES_USER=anco
POSTGRES_PASSWORD=anco-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (cache e fila de tasks futura)
REDIS_URL=redis://cache:6379/0

# Aplicacao
BASE_URL=http://localhost:8000

# As variaveis abaixo entram em fases posteriores.
# Listadas aqui apenas como referencia.

# Google OAuth (Fase 2)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# E-mail SMTP (Fase 7 / producao)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=

# Backup S3-compatible (Fase 7)
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=

# Wayback Machine (Fase 3)
# WAYBACK_API_ENABLED=True
