# Interpolacao do docker-compose. NAO e' o .env do Django, que fica na raiz
# do repositorio — este arquivo so' alimenta a substituicao de variaveis do
# proprio compose.
#
# Serve para rodar mais de um deployment a partir do mesmo repositorio (por
# exemplo, producao e um espelho em validacao) sem que os dois colidam em
# portas ou volumes. Copie para infra/.env e ajuste:
#
#   cp infra/.env.example infra/.env
#
# Sem este arquivo, o compose usa os defaults e tudo funciona como sempre.

# Nome do projeto Compose: isola containers, redes e volumes.
COMPOSE_PROJECT_NAME=anco

# Portas publicadas no loopback do host (o nginx faz o reverse proxy).
ANCO_WEB_PORT=9090
ANCO_ASREVIEW_PORT=9091
